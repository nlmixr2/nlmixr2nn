# Style for the nlmixr2 ecosystem, from rxode2's .lintr.
#
# Two additions, both for things that are NOT free to rename:
#
#   rxDeriv     rxode2's symengine renderer resolves a model function's
#               derivatives BY NAME over the search path -- `nn2_d1_d2` is the
#               name rxode2 looks up, not a style choice.  Renaming the family
#               breaks every Jacobian, and does so silently (R/nnGen-doc.R).
#   mathSymbol  a network's dimensions and the usual matrix/vector symbols:
#               K inputs, H hidden units, J the Jacobian, C a second difference.
#               K and H are part of the internal API shared with the C code
#               (nnSetMeta, nnWeightLayout) and appear in generated model text.
linters: linters_with_defaults(
    object_name_linter(
      styles = "camelCase",
      regexes = c(
        internal = "^\\.[a-z][a-zA-Z0-9]*$",
        s3 = "^[a-z][a-z0-9_]*\\.[a-zA-Z][a-zA-Z0-9]*$",
        rxDeriv = "^nnW?g?[0-9]+(_d[0-9]+){0,2}$",
        mathSymbol = "^\\.?[A-Z][a-zA-Z0-9]{0,2}$"
      )
    ),
    assignment_linter(),
    line_length_linter(120),
    whitespace_linter(),
    pipe_continuation_linter(),
    T_and_F_symbol_linter(),
    # The comment blocks here carry derivative algebra (dR_i/dg, dLL/d(lam)) and
    # one-line usage examples; the heuristic reads both as commented-out code.
    commented_code_linter = NULL,
    infix_spaces_linter = NULL, # Keep disabled for now due to high violation count (8541)
    commas_linter = NULL, # Keep disabled for now (2242)
    cyclocomp_linter(50)
  )
# R/nnGen.R is generated by tools/genNn.R; edit the generator, not the file.
exclusions: list("R/nnGen.R")
