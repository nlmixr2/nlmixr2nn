# Generated from src/Makevars.in by ./configure -- do not edit src/Makevars.
#
# Two training backends, selected by configure:
#   * libtorch (nnTorch.o) when the R 'torch' package has its binaries;
#   * a self-contained Adam/SGD (nnBuiltin.o) otherwise.
# Only one is compiled, so OBJECTS is listed explicitly rather than letting R
# glob every source in this directory.
#
# The torch location is substituted by configure rather than discovered with
# $(shell ...), which is a GNU make extension and not portable.
CXX_STD = CXX17

PKG_CPPFLAGS = @NN_CPPFLAGS@

PKG_LIBS = @NN_LIBS@

OBJECTS = init.o nlmixr2nnContrib.o nnDydtForce.o nnEval.o nnEvalGen.o \
          nnprobe.o nlmixr2nnPtr.o @NN_BACKEND_OBJ@
