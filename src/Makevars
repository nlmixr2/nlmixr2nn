# Link libtorch (the C++ backend shipped inside the R 'torch' package) directly.
# Only nnTorch.cpp pulls in torch/torch.h; the hot-path C files stay plain C.
CXX_STD = CXX17

TORCH_HOME = $(shell "${R_HOME}/bin/Rscript" --vanilla -e 'cat(system.file(package="torch"))')

PKG_CPPFLAGS = -I"$(TORCH_HOME)/include" \
               -I"$(TORCH_HOME)/include/torch/csrc/api/include" \
               -D_GLIBCXX_USE_CXX11_ABI=1

PKG_LIBS = -L"$(TORCH_HOME)/lib" -Wl,-rpath,"$(TORCH_HOME)/lib" \
           -ltorch -ltorch_cpu -lc10
